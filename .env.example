# Kithwheel environment variables.
# Copy to .env.local for local development (never commit real values).
# On your host, set these in the project's environment settings instead.

# --- Database (required) -----------------------------------------------------
# Postgres connection string. In production, include sslmode=require.
DATABASE_URL=postgresql://kithwheel:kithwheel@localhost:5432/kithwheel

# --- Public URL (required) ---------------------------------------------------
# The origin the app is served from, with no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (required) -----------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Usually the same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL=http://localhost:3000
# Other exact origins the app is served on, comma-separated (e.g. https://www.kithwheel.com).
BETTER_AUTH_TRUSTED_ORIGINS=
# The account with this email gets the admin role once its email is verified.
OWNER_EMAIL=

# --- Email (required in production) ------------------------------------------
# Resend API key. Leave empty locally: emails are printed to the server console.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM=Kithwheel <hello@kithwheel.com>
# Optional Reply-To address.
EMAIL_REPLY_TO=

# --- Google sign-in (optional) -----------------------------------------------
# Set both to show "Continue with Google". Redirect URI to register with Google:
#   <BETTER_AUTH_URL>/api/auth/oauth2/callback/google
NEXT_PUBLIC_GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# --- Billing (Stripe) -------------------------------------------------------
# Secret key from Stripe Dashboard > Developers > API keys (sk_test_ until launch).
# After setting it, run `npm run stripe:setup` once to create the product and prices.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <APP_URL>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# "true" once Stripe Tax has a head office address and a registration.
STRIPE_AUTOMATIC_TAX=false

# --- Optional ----------------------------------------------------------------
# Only when the API is served from a different origin than the app.
NEXT_PUBLIC_API_URL=
